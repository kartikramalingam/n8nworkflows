    {
      "parameters": {
        "jsCode": "const defaults = {\n  asofdate: null,\n  securitytype: ['Kartik', 'Akira'],\n  marketSector: ['Sandhya', 'Atharva'],\n  numberofdays: 20,\n  marketcaplowerlimit: 250000,\n  sharefloat: 0.7,\n  operator: 'OR',\n  httpBodies: {\n    market: {\n      filters: {},\n      groups: [\n        { attribute_code: 'marketSector', value: { eq: 'Equity', type: 'text' } }\n      ],\n      logic: 'OR'\n    },\n    equity: {\n  \"logic\": \"OR\",\n  \"groups\": [\n    {\n      \"attribute_code\": \"securitytype\",\n      \"value\": {\n        \"eq\": \"Common Stock\",\n        \"type\": \"text\"\n      },\n      \"asOf\": \"2026-05-06\"\n    }\n  ],\n  \"items_asofdate\": \"2026-01-01T00:00:00Z\",\n  \"items\": [\n    \"figi\",\n    \"shareclassfigi\"\n  ],\n  \"items_scope\": \"node\",\n  \"sort\": [\n    {\n      \"field\": \"valid_from\",\n      \"dir\": \"asc\"\n    }\n  ],\n  \"view\": {\n    \"items\": true,\n    \"ancestors\": true,\n    \"type_buckets\": true,\n    \"canonical_keys\": false\n  }\n\n    }\n  }\n};\n\nfunction deepMerge(target, source) {\n  for (const key in source) {\n    if (source[key] && typeof source[key] === 'object' && !Array.isArray(source[key])) {\n      if (!target[key]) target[key] = {};\n      deepMerge(target[key], source[key]);\n    } else {\n      target[key] = source[key];\n    }\n  }\n  return target;\n}\n\nreturn items.map(item => {\n  const inputBody = item.json.body || {};\n  let output = JSON.parse(JSON.stringify(defaults)); // deep copy\n  \n  output = deepMerge(output, inputBody);\n\n  // Use current date for asofdate if not provided\n  if (!output.asofdate) {\n    output.asofdate = new Date().toISOString().slice(0, 10);\n  }\n\n  // Set items_asofdate and asOf for market\n  output.httpBodies.market.items_asofdate = output.asofdate;\n  if (output.httpBodies.market.groups) {\n    output.httpBodies.market.groups.forEach(g => g.asOf = output.asofdate);\n  }\n\n  // Set items_asofdate and asOf for equity\n  output.httpBodies.equity.items_asofdate = output.asofdate;\n  if (output.httpBodies.equity.groups) {\n    output.httpBodies.equity.groups.forEach(g => g.asOf = output.asofdate);\n  }\n\n  item.json = output;\n  return item;\n});\n"
      },
