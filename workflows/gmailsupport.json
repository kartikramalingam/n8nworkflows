    {
      "parameters": {
        "jsCode": "// This node splits the AI output array into separate items\n// so each category can be routed independently\n\nconst aiOutput = $input.item.json.output;\nconst gmailMetadata = {\n  gmailMessageId: $('Get emails (last 24h)').first().json.id,\n  gmailSubject: $('Get emails (last 24h)').first().json.headers.subject,\n  gmailBody: $('Get emails (last 24h)').first().json.text\n};\n\n// If output is already an array, spread it\nif (Array.isArray(aiOutput)) {\n  return aiOutput.map(item => ({\n    json: {\n      ...item,\n      ...gmailMetadata\n    }\n  }));\n}\n\n// If output is a single object, wrap it in array\nreturn [{\n  json: {\n    ...aiOutput,\n    ...gmailMetadata\n  }\n}];"
      },
